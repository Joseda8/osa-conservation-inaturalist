# Local Python environment
.venv/

# Local environment variables and credentials.
.env
.secrets/*
!.secrets/.gitkeep

# Frontend dependencies and generated static site files.
web/node_modules/
web/dist/
web/public/data/*.csv

# Python bytecode and caches
__pycache__/
*.py[cod]

# Downloaded/generated data files
data/
*.json
!web/package.json
!web/package-lock.json
!web/public/data/
!web/public/data/.gitkeep

# Local PostgreSQL backup files
db/backups/*
!db/backups/.gitkeep

# Developer notes
DEV_NOTES.md
DEPLOYMENT_AND_VISUALIZATION_OPTIONS.md
USER_NOTES.md
static-publishing-architecture.png
